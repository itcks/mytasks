# --- Обязательные ---
# Секрет для JWT-токенов: сгенерируйте командой
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# --- Ключ для прямого API бота (заголовок X-Bot-Key) ---
BOT_API_KEY=change-me-bot-key

# --- Окружение ---
# production: сервер слушает только 127.0.0.1, статика кешируется 1 час
NODE_ENV=production

# --- МАКС-бот (заполнить позже, когда создадите бота в МАКС) ---
# Токен бота из @MasterBot в МАКС
MAX_BOT_TOKEN=
# Адрес Bot API (по умолчанию https://botapi.max.ru)
# MAX_API_URL=
